@page "/devices"
@rendermode InteractiveServer
@using TravelGuide.AdminWeb.Services
@using TravelGuide.Core.DTOs
@inject IDeviceManagementService DeviceService
@inject IAdminAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Theo dõi thiết bị – Travel Guide Admin</PageTitle>

@if (!AuthService.GetSession().IsLoggedIn)
{
    <MudText>Đang chuyển hướng...</MudText>
    return;
}

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto pa-6">

    <!-- HEADER -->
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">📱 Theo dõi thiết bị</MudText>

        <MudStack Row="true" Spacing="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="align-self-center">
                Cập nhật lúc @_lastRefresh.ToString("HH:mm:ss")
            </MudText>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadData"
                       Disabled="_isLoading">
                Làm mới
            </MudButton>
        </MudStack>
    </MudStack>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    }
    else if (_stats == null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            Không thể tải dữ liệu. Kiểm tra API đang chạy chưa.
        </MudAlert>
    }
    else
    {
        <!-- STAT CARDS -->
        <MudGrid Class="mb-6">

            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudStack AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Devices" Color="Color.Primary" Size="Size.Large" />
                            <MudText Typo="Typo.h3" Color="Color.Primary">@_stats.TotalDevices</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Tổng thiết bị</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Style="border-left:4px solid #4CAF50">
                    <MudCardContent>
                        <MudStack AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Color="Color.Success" Size="Size.Large" />
                            <MudText Typo="Typo.h3" Color="Color.Success">@_stats.ActiveToday</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Đang hoạt động</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Style="border-left:4px solid #2196F3">
                    <MudCardContent>
                        <MudStack AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Color="Color.Info" Size="Size.Large" />
                            <MudText Typo="Typo.h3" Color="Color.Info">@_stats.TotalScans</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Tổng lượt scan QR</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

        </MudGrid>

        <!-- CHARTS -->
        <MudGrid Class="mb-6">

            <!-- Tổng quan -->
            <MudItem xs="12" md="4">
                <MudCard Class="pa-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-3">👤 Tổng quan</MudText>

                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText>Thiết bị</MudText>
                        <MudChip>@_stats.GuestDevices</MudChip>
                    </MudStack>

                    <MudProgressLinear Value="@GetPercent(_stats.GuestDevices, _stats.TotalDevices)" />

                    <MudDivider Class="my-2" />

                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText>📅 30 ngày</MudText>
                        <MudChip Color="Color.Secondary">@_stats.ActiveThisMonth</MudChip>
                    </MudStack>
                </MudCard>
            </MudItem>

            <!-- Ngôn ngữ -->
            <MudItem xs="12" md="4">
                <MudCard Class="pa-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-3">🌐 Ngôn ngữ</MudText>

                    @foreach (var lang in _stats.ByLanguage)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText>@GetLangFlag(lang.LanguageCode) @GetLangName(lang.LanguageCode)</MudText>
                            <MudChip Color="Color.Primary">@lang.Count</MudChip>
                        </MudStack>

                        <MudProgressLinear Value="@GetPercent(lang.Count, _stats.TotalDevices)" Class="mb-2" />
                    }
                </MudCard>
            </MudItem>

            <!-- Platform -->
            <MudItem xs="12" md="4">
                <MudCard Class="pa-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-3">📱 Platform</MudText>

                    @foreach (var plat in _stats.ByPlatform)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText>@GetPlatformIcon(plat.Platform) @plat.Platform</MudText>
                            <MudChip Color="Color.Secondary">@plat.Count</MudChip>
                        </MudStack>

                        <MudProgressLinear Value="@GetPercent(plat.Count, _stats.TotalDevices)" Class="mb-2" />
                    }
                </MudCard>
            </MudItem>

        </MudGrid>

        <!-- TABLE -->
        <MudPaper Class="pa-4">

            <MudText Typo="Typo.h6" Class="mb-3">
                📋 Thiết bị gần đây
            </MudText>

            <MudTable Items="@FilteredDevices"
                      Hover="true"
                      Dense="true"
                      RowsPerPage="20">

                <HeaderContent>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>DeviceId</MudTh>
                    <MudTh>Người dùng</MudTh>
                    <MudTh>Platform</MudTh>
                    <MudTh>Ngôn ngữ</MudTh>
                    <MudTh>Scan</MudTh>
                    <MudTh>Phiên</MudTh>
                    <MudTh>Lần đầu</MudTh>
                    <MudTh>Gần nhất</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>
                        @if (context.IsOnline)
                        {
                            <MudChip Color="Color.Success">Online</MudChip>
                        }
                        else
                        {
                            <MudChip>Offline</MudChip>
                        }
                    </MudTd>

                    <MudTd>@context.DeviceId[..8]...</MudTd>

                    <MudTd>
                        @if (context.Username != null)
                        {
                            <MudChip Color="Color.Primary">@context.Username</MudChip>
                        }
                        else
                        {
                            <MudText>Guest</MudText>
                        }
                    </MudTd>

                    <MudTd>@context.Platform</MudTd>
                    <MudTd>@context.LanguageCode</MudTd>
                    <MudTd>@context.ScanCount</MudTd>
                    <MudTd>@context.SessionCount</MudTd>
                    <MudTd>@context.FirstSeenAt.ToString("dd/MM")</MudTd>
                    <MudTd>@GetTimeAgo(context.LastSeenAt)</MudTd>

                </RowTemplate>

            </MudTable>

        </MudPaper>
    }

</MudContainer>

@code {
    private DeviceStatsDto? _stats;
    private bool _isLoading = true;
    private DateTime _lastRefresh = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.GetSession().IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;

        var token = AuthService.GetSession().Token ?? "";
        _stats = await DeviceService.GetStatsAsync(token);

        _lastRefresh = DateTime.Now;
        _isLoading = false;
    }

    private IEnumerable<DeviceListItemDto> FilteredDevices =>
        _stats?.RecentDevices ?? Enumerable.Empty<DeviceListItemDto>();

    private static double GetPercent(int value, int total)
        => total == 0 ? 0 : (double)value / total * 100;

    private static string GetLangFlag(string code) => code switch
    {
        "vi" => "🇻🇳",
        "en" => "🇺🇸",
        "ja" => "🇯🇵",
        _ => "🌐"
    };

    private static string GetLangName(string code) => code;

    private static string GetPlatformIcon(string p) => p.ToLower() switch
    {
        "android" => "🤖",
        "ios" => "🍎",
        _ => "📱"
    };

    private static string GetTimeAgo(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 1) return "vừa xong";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}p";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h";
        return $"{(int)diff.TotalDays}d";
    }
}