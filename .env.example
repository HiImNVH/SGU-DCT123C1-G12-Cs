# Mobile app configuration (set these in the launch/build environment)
TRAVELGUIDE_API_BASE_URL=http://10.0.2.2:5171
TRAVELGUIDE_GOONG_MAPTILE_KEY=replace-with-your-goong-maptile-key
TRAVELGUIDE_GOONG_API_KEY=replace-with-your-goong-rest-api-key

# ASP.NET Core uses double underscores for nested configuration keys.
Jwt__Key=replace-with-a-random-secret-at-least-32-characters
SeedAdmin__Enabled=false
SeedAdmin__Username=demo-admin
SeedAdmin__Password=replace-with-a-demo-password
GoongSettings__MaptileKey=replace-with-your-goong-maptile-key
